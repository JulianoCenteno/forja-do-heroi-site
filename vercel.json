{
 "cleanUrls": true,
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/up-4f7159faf3e680ec85e925b3/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "https://acesso.appdigitalhub.com.br"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  },
  {
   "source": "/app/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    }
   ]
  }
 ]
}